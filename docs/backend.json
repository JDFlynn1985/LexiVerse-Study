
{
  "entities": {
    "UserStudyProfile": {
      "title": "User Study Profile",
      "description": "Metadata about the user's study preferences and academic status. Access is restricted to self and admins.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "credentials": { "type": "string", "description": "Academic or professional titles (e.g. PhD, MDiv, Seminary Student)." },
        "designation": {
          "type": "string",
          "enum": [
            "Professor",
            "Undergraduate Seminary Student",
            "Master's Degree Candidate",
            "Doctoral Candidate",
            "Non-Seminary Student"
          ],
          "description": "The user's primary scholarly role or academic status."
        },
        "degreeSubject": { "type": "string", "description": "The major or field of study (e.g. Biblical Languages, Systematic Theology)." },
        "academicLevel": { "type": "string", "description": "The current year or level (e.g. Freshman, Year 1, PhD Level 1)." },
        "institutionId": { "type": "string", "description": "Reference to the AcademicInstitution entity." },
        "bio": { "type": "string", "description": "A brief scholarly biography explaining research interests." },
        "isAdmin": { "type": "boolean", "description": "System administration privilege. Can only be granted by another admin." },
        "isModerator": { "type": "boolean", "description": "Moderator privilege for peer review." },
        "isTrustedContributor": { "type": "boolean", "description": "Privilege to bypass peer review for posts." },
        "preferences": {
          "type": "object",
          "properties": {
            "modelProvider": { 
              "type": "string", 
              "enum": ["google", "local"],
              "description": "Whether to use cloud-based Google AI or locally hosted models."
            },
            "selectedModel": { 
              "type": "string",
              "description": "The specific model name (e.g. gemini-2.5-flash, llama3)."
            },
            "customApiKey": {
              "type": "string",
              "description": "The user's personal Google AI API key. Encrypted at rest."
            },
            "ollamaUrl": {
              "type": "string",
              "description": "Custom endpoint for local Ollama inference."
            },
            "preferredBibleVersion": {
              "type": "string",
              "description": "The user's preferred Bible translation."
            },
            "language": {
              "type": "string",
              "description": "The user's preferred interface language."
            },
            "storagePreference": {
              "type": "string",
              "enum": ["cloud", "local"],
              "description": "Whether to store credentials in Firestore or browser local storage."
            }
          }
        }
      },
      "required": ["uid"]
    },
    "AcademicInstitution": {
      "title": "Academic Institution",
      "description": "Details about a seminary, university, or research center.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "website": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A real-time message sent in the social chat system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "senderPhotoURL": { "type": "string" },
        "senderDesignation": { "type": "string" },
        "senderInstitutionName": { "type": "string" },
        "type": { "type": "string", "enum": ["global", "institutional"] },
        "institutionId": { "type": "string", "description": "Target institution ID for filtered chat." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "senderUid", "type", "createdAt"]
    },
    "APIKey": {
      "title": "API Key",
      "description": "Authentication credentials for external research access.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string", "description": "The secret API key string." },
        "ownerUid": { "type": "string" },
        "label": { "type": "string", "description": "Identifier for the key (e.g. 'Logos Integration')." },
        "tier": { "type": "string", "description": "The access tier (e.g. 'Basic', 'Scholar')." },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastUsedAt": { "type": "string", "format": "date-time" },
        "usageCount": { "type": "number" },
        "revoked": { "type": "boolean" }
      },
      "required": ["key", "ownerUid", "tier"]
    },
    "WikiEntry": {
      "title": "Wiki Entry",
      "description": "A scholarly wiki article requiring citations and moderation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "worksCited": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "status", "authorUid"]
    },
    "ErrorLog": {
      "title": "Error Log",
      "description": "A capture of a system or permission error for administrative audit.",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "stack": { "type": "string" },
        "type": { "type": "string" },
        "userId": { "type": "string" },
        "url": { "type": "string" },
        "userAgent": { "type": "string" },
        "context": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["message", "timestamp"]
    },
    "SystemSettings": {
      "title": "System Settings",
      "description": "Global application configuration.",
      "type": "object",
      "properties": {
        "geminiApiKey": { "type": "string" },
        "defaultModelProvider": { "type": "string", "enum": ["google", "local"] },
        "defaultModel": { "type": "string" },
        "networkMode": { "type": "string", "enum": ["internet", "local-only"] },
        "apiTiers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "requestsPerDay": { "type": "number" },
              "description": { "type": "string" }
            }
          }
        },
        "isConfigured": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserStudyProfile",
      "description": "User's study profile and role flags."
    },
    "/system/config": {
      "schema": "#/backend/entities/SystemSettings",
      "description": "Global system configuration."
    },
    "/system/error_logs/{logId}": {
        "schema": "#/backend/entities/ErrorLog",
        "description": "Application error logs."
    },
    "/api_keys/{keyId}": {
      "schema": "#/backend/entities/APIKey",
      "description": "External access keys."
    },
    "/wiki_entries/{entryId}": {
      "schema": "#/backend/entities/WikiEntry",
      "description": "Scholarly wiki articles."
    },
    "/institutions/{institutionId}": {
      "schema": "#/backend/entities/AcademicInstitution",
      "description": "Directory of scholarly institutions."
    },
    "/messages/{messageId}": {
      "schema": "#/backend/entities/ChatMessage",
      "description": "Chat messages for the social research system."
    }
  }
}
