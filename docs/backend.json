
{
  "entities": {
    "UserStudyProfile": {
      "title": "User Study Profile",
      "description": "Metadata about the user's study preferences and linked external accounts.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "credentials": { "type": "string", "description": "Academic or professional titles (e.g. PhD, MDiv, Seminary Student)." },
        "bio": { "type": "string", "description": "A brief scholarly biography explaining research interests." },
        "isAdmin": { "type": "boolean", "description": "Whether the user has administrative privileges." },
        "isModerator": { "type": "boolean", "description": "Whether the user has moderator privileges for the wiki and blog." },
        "isTrustedContributor": { "type": "boolean", "description": "Whether the user can post wiki and blog entries without peer review." },
        "preferences": {
          "type": "object",
          "properties": {
            "modelProvider": { 
              "type": "string", 
              "enum": ["google", "local"],
              "description": "Whether to use cloud-based Google AI or locally hosted models."
            },
            "selectedModel": { 
              "type": "string",
              "description": "The specific model name (e.g. gemini-2.5-flash, llama3)."
            },
            "ollamaUrl": {
              "type": "string",
              "description": "Custom endpoint for local Ollama inference."
            },
            "preferredBibleVersion": {
              "type": "string",
              "description": "The user's preferred Bible translation."
            },
            "language": {
              "type": "string",
              "description": "The user's preferred interface language."
            }
          }
        }
      },
      "required": ["uid"]
    },
    "WikiEntry": {
      "title": "Wiki Entry",
      "description": "A scholarly wiki article requiring citations and moderation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "worksCited": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "status", "authorUid"]
    },
    "BlogPost": {
      "title": "Blog Post",
      "description": "A reflective or narrative scholarly blog post.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "category": { 
          "type": "string", 
          "enum": ["Linguistics", "Theology", "History", "Archaeology", "Hermeneutics", "General"],
          "description": "The primary scholarly category of the post."
        },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "content", "status", "authorUid", "category"]
    },
    "SystemSettings": {
      "title": "System Settings",
      "description": "Global application configuration stored in Firestore.",
      "type": "object",
      "properties": {
        "adminUsername": { "type": "string" },
        "adminPassword": { "type": "string" },
        "geminiApiKey": { "type": "string" },
        "ollamaUrl": { "type": "string" },
        "localModelList": { "type": "array", "items": { "type": "string" }, "description": "A list of locally available models via Ollama." },
        "defaultModelProvider": { "type": "string", "enum": ["google", "local"] },
        "isConfigured": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserStudyProfile",
      "description": "User's study profile and role flags."
    },
    "/system/config": {
      "schema": "#/backend/entities/SystemSettings",
      "description": "Global system configuration."
    },
    "/wiki_entries/{entryId}": {
      "schema": "#/backend/entities/WikiEntry",
      "description": "Scholarly wiki articles."
    },
    "/blog_posts/{postId}": {
      "schema": "#/backend/entities/BlogPost",
      "description": "Scholarly blog posts."
    }
  }
}
