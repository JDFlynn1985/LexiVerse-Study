
{
  "openapi": "3.0.0",
  "info": {
    "title": "LexiVerse Scholarly Research API",
    "description": "RESTful access to the LexiVerse research engine for external scholarly tools.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Local production server"
    }
  ],
  "paths": {
    "/research": {
      "post": {
        "summary": "Perform AI-powered scripture research",
        "description": "Executes a research synthesis flow based on a term and optional context.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "term"
                ],
                "properties": {
                  "term": {
                    "type": "string",
                    "description": "Scripture reference or linguistic term."
                  },
                  "researchContext": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Optional excerpts for RAG context."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful research results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "type": "object" },
                    "meta": { "type": "object" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
