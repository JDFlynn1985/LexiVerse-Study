
{
  "entities": {
    "UserStudyProfile": {
      "title": "User Study Profile",
      "description": "Metadata about the user's study preferences and linked external accounts.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "isAdmin": { "type": "boolean", "description": "Whether the user has administrative/moderator privileges." },
        "preferences": {
          "type": "object",
          "properties": {
            "selectedModel": { 
              "type": "string", 
              "enum": ["googleai/gemini-2.5-flash", "googleai/gemini-2.5-pro-001"],
              "description": "The selected AI engine."
            },
            "customApiKey": { "type": "string" },
            "preferredBibleVersion": {
              "type": "string",
              "description": "The user's preferred Bible translation (e.g., kjv, net)."
            }
          }
        }
      },
      "required": ["uid"]
    },
    "SearchLog": {
      "title": "Search Log",
      "description": "Log of research queries for administrative analysis.",
      "type": "object",
      "properties": {
        "term": { "type": "string" },
        "type": { "type": "string", "enum": ["lexicon", "dictionary", "commentary", "scripture", "theology", "timeline"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "uid": { "type": "string" }
      }
    },
    "WikiEntry": {
      "title": "Wiki Entry",
      "description": "A scholarly wiki article requiring citations and moderation.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "worksCited": { "type": "string" },
        "bibliography": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "worksCited", "bibliography", "status"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserStudyProfile",
      "description": "User's study profile and settings."
    },
    "/search_logs/{logId}": {
      "schema": "#/backend/entities/SearchLog",
      "description": "Centralized logs for search analysis."
    },
    "/wiki_entries/{entryId}": {
      "schema": "#/backend/entities/WikiEntry",
      "description": "Scholarly wiki articles."
    }
  }
}
