
{
  "entities": {
    "UserStudyProfile": {
      "title": "User Study Profile",
      "description": "Metadata about the user's study preferences and linked external accounts.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "isAdmin": { "type": "boolean", "description": "Whether the user has administrative privileges." },
        "isModerator": { "type": "boolean", "description": "Whether the user has moderator privileges for the wiki." },
        "isTrustedContributor": { "type": "boolean", "description": "Whether the user can post wiki entries without peer review." },
        "preferences": {
          "type": "object",
          "properties": {
            "selectedModel": { 
              "type": "string", 
              "enum": ["googleai/gemini-2.5-flash", "googleai/gemini-2.5-pro-001"],
              "description": "The selected AI engine."
            },
            "preferredBibleVersion": {
              "type": "string",
              "description": "The user's preferred Bible translation."
            },
            "language": {
              "type": "string",
              "description": "The user's preferred interface language."
            }
          }
        }
      },
      "required": ["uid"]
    },
    "WikiEntry": {
      "title": "Wiki Entry",
      "description": "A scholarly wiki article requiring citations and moderation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "worksCited": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "status", "authorUid"]
    },
    "SystemSettings": {
      "title": "System Settings",
      "description": "Global application configuration stored in Firestore.",
      "type": "object",
      "properties": {
        "adminUsername": { "type": "string" },
        "adminPassword": { "type": "string" },
        "geminiApiKey": { "type": "string" },
        "isConfigured": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserStudyProfile",
      "description": "User's study profile and role flags."
    },
    "/system/config": {
      "schema": "#/backend/entities/SystemSettings",
      "description": "Global system configuration."
    },
    "/wiki_entries/{entryId}": {
      "schema": "#/backend/entities/WikiEntry",
      "description": "Scholarly wiki articles."
    }
  }
}
