
{
  "entities": {
    "UserStudyProfile": {
      "title": "User Study Profile",
      "description": "Metadata about the user's study preferences and academic status. Access is restricted to self and admins.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "credentials": { "type": "string", "description": "Academic or professional titles (e.g. PhD, MDiv, Seminary Student)." },
        "designation": {
          "type": "string",
          "enum": [
            "Professor",
            "Undergraduate Seminary Student",
            "Master's Degree Candidate",
            "Doctoral Candidate",
            "Non-Seminary Student"
          ],
          "description": "The user's primary scholarly role or academic status."
        },
        "degreeSubject": { "type": "string", "description": "The major or field of study (e.g. Biblical Languages, Systematic Theology)." },
        "academicLevel": { "type": "string", "description": "The current year or level (e.g. Freshman, Year 1, PhD Level 1)." },
        "institutionId": { "type": "string", "description": "Reference to the AcademicInstitution entity." },
        "bio": { "type": "string", "description": "A brief scholarly biography explaining research interests." },
        "isAdmin": { "type": "boolean", "description": "System administration privilege. Can only be granted by another admin." },
        "isModerator": { "type": "boolean", "description": "Moderator privilege for peer review." },
        "isTrustedContributor": { "type": "boolean", "description": "Privilege to bypass peer review for posts." },
        "preferences": {
          "type": "object",
          "properties": {
            "modelProvider": { 
              "type": "string", 
              "enum": ["google", "local", "openai", "anthropic", "mistral", "deepseek", "xai"],
              "description": "The active AI engine provider."
            },
            "selectedModel": { 
              "type": "string",
              "description": "The specific model name."
            },
            "googleKey": { "type": "string" },
            "openaiKey": { "type": "string" },
            "anthropicKey": { "type": "string" },
            "mistralKey": { "type": "string" },
            "deepseekKey": { "type": "string" },
            "xaiKey": { "type": "string" },
            "ollamaUrl": { "type": "string" },
            "preferredBibleVersion": { "type": "string" },
            "language": { "type": "string" },
            "storagePreference": { "type": "string", "enum": ["cloud", "local"] }
          }
        }
      },
      "required": ["uid"]
    },
    "ResearchSession": {
      "title": "Research Session",
      "description": "A saved research report generated by the AI Hub.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["assistant", "lexicon", "theology", "archaeology", "timeline"] },
        "data": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "title", "data"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserStudyProfile",
      "description": "User's study profile and role flags."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "#/backend/entities/ResearchSession",
      "description": "User's saved research reports."
    },
    "/system/config": {
      "schema": "#/backend/entities/SystemSettings",
      "description": "Global system configuration."
    }
  }
}
